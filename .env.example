# Patch environment configuration

# The LLM target. The default simulator does not require any external service.
# Set this to a real Ollama endpoint to talk to a running `gemma4:31b-cloud`.
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma4:31b-cloud

# Persistence backend. Defaults to file-based JSON under ./data.
PATCH_DB_DIR=./data

# Cookie security: set PATCH_SESSION_SECRET in production. When unset, a
# random secret is generated per process.
PATCH_SESSION_SECRET=
